# Copy to .env.local. Never commit real values.

# Claude API
ANTHROPIC_API_KEY=
# Optional overrides; defaults live in src/agents/models.ts
MODEL_FAST=
MODEL_STANDARD=
MODEL_DEEP=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Local Supabase default (npm run db:start)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Inngest (INNGEST_DEV=1 sends events to the local dev server: npm run inngest)
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optimizer service (hosted: the Render URL, and the shared secret it requires)
OPTIMIZER_URL=http://localhost:8001
OPTIMIZER_TOKEN=

# Hosted deployments: set to "off" to stop the hourly Auditor and weekly reviews spending money
SCHEDULED_AGENTS=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=

# Outbox delivery (optional). Approved messages from live worlds are POSTed here as JSON, e.g. to
# an n8n webhook that sends email. Empty: messages stay "not configured". Drills never send.
OUTBOUND_WEBHOOK_URL=
# Signs each request: header x-deviation-desk-signature = sha256=HMAC(body).
OUTBOUND_WEBHOOK_SECRET=
