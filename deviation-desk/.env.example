# Copy to .env.local. Never commit real values.

# Claude API
ANTHROPIC_API_KEY=
# Optional overrides; defaults live in src/agents/models.ts
MODEL_FAST=
MODEL_STANDARD=
MODEL_DEEP=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase default (npm run db:start)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optimizer service
OPTIMIZER_URL=http://localhost:8001

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=

# n8n
N8N_WEBHOOK_URL=
