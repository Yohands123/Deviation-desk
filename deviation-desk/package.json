{
  "name": "deviation-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Incident readiness and response platform for life sciences operations.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "inngest": "npx inngest-cli@latest dev",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "evals": "tsx --conditions=react-server --env-file-if-exists=.env.local evals/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:migrate && npm run db:seed",
    "test:db": "vitest run --project db"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@langfuse/otel": "5.13.1",
    "@langfuse/tracing": "5.13.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.223.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@sentry/nextjs": "11.7.0",
    "@supabase/supabase-js": "2.117.3",
    "inngest": "4.23.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
